---
interface Props {
  href?: string;
  label: string;
  variant?: 'primary' | 'inverse' | 'copper' | 'outline-light' | 'text';
  external?: boolean;
  class?: string;
  ariaLabel?: string;
  type?: 'button' | 'submit';
}

const {
  href,
  label,
  variant = 'primary',
  external = false,
  class: className = '',
  ariaLabel,
  type = 'button',
} = Astro.props;

const classes = ['cta', `cta--${variant}`, className];
const iconClass = external ? 'cta__icon cta__icon--external' : 'cta__icon';
---

{href ? (
  <a class:list={classes} href={href} target={external ? '_blank' : undefined} rel={external ? 'noopener noreferrer' : undefined} aria-label={ariaLabel}>
    <span class="cta__label">{label}</span>
    <span class={iconClass} aria-hidden="true">
      {external ? (
        <svg viewBox="0 0 20 20" focusable="false"><path d="M5 15 15 5M8 5h7v7" /></svg>
      ) : (
        <svg viewBox="0 0 20 20" focusable="false"><path d="M3 10h13M11 5l5 5-5 5" /></svg>
      )}
    </span>
  </a>
) : (
  <button class:list={classes} type={type} aria-label={ariaLabel}>
    <span class="cta__label">{label}</span>
    <span class={iconClass} aria-hidden="true">
      <svg viewBox="0 0 20 20" focusable="false"><path d="M3 10h13M11 5l5 5-5 5" /></svg>
    </span>
  </button>
)}
