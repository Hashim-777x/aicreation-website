---
import Brand from './Brand.astro';

import ActionLink from './ActionLink.astro';
const route = Astro.url.pathname.replace(/\/$/, '') || '/';
const isContact = route === '/contact';
const messages: Record<string, { lines: string[]; note: string; copy: string; action: string }> = {
  '/': { lines: ['Your next chapter', 'deserves imagination.'], note: 'AI made. Human directed.', copy: 'A clear idea. A considered direction. Tell us what your brand needs next.', action: 'Discuss your project' },
  '/work': { lines: ['Your brand.', 'Our next creative brief.'], note: 'Every detail earns its place.', copy: 'Bring your product, audience and ambition. We will shape the visual direction around them.', action: 'Discuss your campaign' },
  '/ai-creative': { lines: ['Made with AI.', 'Refined for your brand.'], note: 'Human judgement at every stage.', copy: 'From product detail to the final frame, we keep your brief at the centre of the creative process.', action: 'Discuss your creative brief' },
  '/agents': { lines: ['Build the workflow.', 'Keep the judgement.'], note: 'Your process. Your approval.', copy: 'Start with one useful task. Define the inputs, review points and boundaries before building.', action: 'Discuss your workflow' },
  '/studio': { lines: ['A small studio.', 'Close to your vision.'], note: 'Direct collaboration. Considered work.', copy: 'Work directly with the people shaping your project, from the first conversation to the final details.', action: 'Meet us through your brief' },
  '/contact': { lines: ['Good work starts', 'with a conversation.'], note: 'Your brief sets the direction.', copy: '', action: '' },
};
const message = messages[route] ?? messages['/'];

---
<footer id="contact" class="site-footer" data-cosmic-footer>
  <picture class="footer-media">
    <source media="(max-width: 767px)" type="image/avif" srcset="/media/footer/cosmic-footer-mobile-640.avif 640w, /media/footer/cosmic-footer-mobile-960.avif 960w, /media/footer/cosmic-footer-mobile-1440.avif 1440w, /media/footer/cosmic-footer-mobile-2240.avif 2240w" />
    <source media="(max-width: 767px)" type="image/webp" srcset="/media/footer/cosmic-footer-mobile-640.webp 640w, /media/footer/cosmic-footer-mobile-960.webp 960w, /media/footer/cosmic-footer-mobile-1440.webp 1440w, /media/footer/cosmic-footer-mobile-2240.webp 2240w" />
    <source media="(min-width: 768px)" type="image/avif" srcset="/media/footer/cosmic-footer-desktop-1280.avif 1280w, /media/footer/cosmic-footer-desktop-1920.avif 1920w, /media/footer/cosmic-footer-desktop-2560.avif 2560w, /media/footer/cosmic-footer-desktop-3840.avif 3840w" />
    <source media="(min-width: 768px)" type="image/webp" srcset="/media/footer/cosmic-footer-desktop-1280.webp 1280w, /media/footer/cosmic-footer-desktop-1920.webp 1920w, /media/footer/cosmic-footer-desktop-2560.webp 2560w, /media/footer/cosmic-footer-desktop-3840.webp 3840w" />
    <source media="(max-width: 767px)" type="image/png" srcset="/media/footer/cosmic-footer-mobile.png" />
    <source media="(min-width: 768px)" type="image/png" srcset="/media/footer/cosmic-footer-desktop.png" />
    <img src="/media/footer/cosmic-footer-desktop.png" alt="A lone figure in a grass field beneath a detailed Earth-like planet and deep star field" loading="lazy" decoding="async" width="3840" height="1646" />
  </picture>
  <div class="footer-overlay"></div>
  <div class:list={["footer-content", {"footer-content--contact": isContact}]}>
    <div class="footer-message">
      <a class="brand" href="/" aria-label="AIcreation.pro home"><Brand variant="white" /></a>
      <h2>{message.lines.map((line, index) => <>{index > 0 && <br />}{line}</>)}</h2>
      <p class="footer-line">{message.note}</p>
    </div>
    {!isContact && <div class="footer-invitation">
      <p>{message.copy}</p>
      <ActionLink href="/contact#brief" label={message.action} variant="inverse" />
    </div>}
  </div>
  <div class="footer-meta">
    <div class="footer-legal-row">
      <p>© {new Date().getFullYear()} AIcreation.pro</p>
      <nav aria-label="Legal navigation"><a href="/privacy">Privacy Policy</a><a href="/terms">Terms of Use</a></nav>
    </div>
  </div>
  <p class="footer-signoff"><Brand variant="white" symbolOnly={true} class="brand-signature-mark" />A more human tomorrow.</p>
</footer>

<script>
  if (!window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
    const footers = [...document.querySelectorAll<HTMLElement>('[data-cosmic-footer]')];
    let footerFrame = 0;
    const renderFooters = () => {
      const viewportHeight = Math.max(window.innerHeight, 1);
      footers.forEach((footer) => {
        const bounds = footer.getBoundingClientRect();
        const progress = Math.max(0, Math.min(1, (viewportHeight - bounds.top) / (viewportHeight + bounds.height)));
        footer.style.setProperty('--footer-shift', `${((progress - .5) * 24).toFixed(2)}px`);
        footer.style.setProperty('--footer-scale', `${(1.02 - progress * .012).toFixed(4)}`);
      });
      footerFrame = 0;
    };
    const updateFooters = () => { if (!footerFrame) footerFrame = requestAnimationFrame(renderFooters); };
    window.addEventListener('scroll', updateFooters, { passive: true });
    window.addEventListener('resize', updateFooters, { passive: true });
    updateFooters();
  }
</script>
