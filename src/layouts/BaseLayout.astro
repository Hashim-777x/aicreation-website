---
import '@fontsource/dm-sans/400.css';
import '@fontsource/dm-sans/500.css';
import '@fontsource/dm-sans/700.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@/styles/global.css';
import '@/styles/sections.css';
import '@/styles/pages.css';
import '@/styles/mobile.css';
import '@/styles/typography.css';
import '@/styles/motion.css';
import { routeSeo } from '@/data/seo';
import { structuredDataFor } from '@/data/structured-data';

interface Props { title: string; description: string; noindex?: boolean }
const route = Astro.url.pathname.replace(/\/$/, '') || '/';
const { title, description } = routeSeo[route] ?? Astro.props;
const canonical = new URL(route, Astro.site ?? 'https://aicreation.pro').href;
const socialImage = new URL('/media/social-preview.jpg', Astro.site ?? 'https://aicreation.pro').href;
const structuredData = structuredDataFor(route, canonical, title, description);
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#1d0708" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
        <meta name="robots" content={(Astro.props.noindex || import.meta.env.PUBLIC_SITE_INDEXABLE === 'false') ? 'noindex, nofollow' : 'index, follow, max-image-preview:large'} />
    <meta property="og:site_name" content="AIcreation.pro" />
    <meta property="og:image" content={socialImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="AIcreation.pro — human-directed creative imagery" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={socialImage} />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="canonical" href={canonical} />
    <script type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\u003c')} />
    <title>{title}</title>
  </head>
  <body>
    <noscript><style>[data-reveal]{opacity:1!important;transform:none!important;clip-path:none!important}</style></noscript>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <slot />
    <script>import "@/scripts/mobile-reveals";</script>
    <script>
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const revealItems = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
      if (reduced) revealItems.forEach((item) => item.dataset.visible = 'true');
      else {
        const revealObserver = new IntersectionObserver((entries) => entries.forEach((entry) => {
          if (entry.isIntersecting) { (entry.target as HTMLElement).dataset.visible = 'true'; revealObserver.unobserve(entry.target); }
        }), { threshold: .14, rootMargin: '0px 0px -8% 0px' });
        revealItems.forEach((item) => revealObserver.observe(item));
      }
      const managedVideos = [...document.querySelectorAll<HTMLVideoElement>('video[data-managed-video]')];
      const videoObserver = new IntersectionObserver((entries) => entries.forEach((entry) => {
        const video = entry.target as HTMLVideoElement;
        if (!reduced && entry.isIntersecting) video.play().catch(() => undefined); else video.pause();
      }), { threshold: .35 });
      managedVideos.forEach((video) => videoObserver.observe(video));
    </script>
  </body>
</html>

