---
import BaseLayout from '@/layouts/BaseLayout.astro'; import PageHero from '@/components/PageHero.astro'; import Footer from '@/components/Footer.astro'; import ResponsiveImage from '@/components/ResponsiveImage.astro'; import { projects } from '@/data/site';
---
<BaseLayout title="Selected Work — AIcreation.pro" description="Concept studies in product, fashion and spaces.">
  <main>
    <PageHero headerTheme="dark" brandTheme="dark" class="work-page-hero" title="Selected<br />work." intro="Concept studies in image, film and space." desktop="work-page-hero-desktop" mobile="work-page-hero-mobile" />
    <section class="editorial-section work-index section-space--feature">
      {projects.map((project)=><article id={project.slug} class="work-index-row" data-reveal><span>{project.number}</span><div><strong>{project.title.toUpperCase()}</strong><p>Concept study · human directed.</p></div><ResponsiveImage desktop={`${project.slug}-desktop`} mobile={`${project.slug}-mobile`} widths={{desktop:[800,1280],mobile:[640,941]}} alt={project.previewAlt} /></article>)}
    </section>
    <section class="editorial-section section-space--standard" data-reveal><h2>From source<br />to scene.</h2><p class="lead">The same product, a different world. AI as a creative tool, directed by humans.</p><div class="comparison-wide"><ResponsiveImage desktop="perfume-source-desktop" mobile="perfume-source-mobile" widths={{desktop:[640,1000],mobile:[640,941]}} alt="Perfume source concept"/><ResponsiveImage desktop="perfume-finished-desktop" mobile="perfume-finished-mobile" widths={{desktop:[640,1000],mobile:[640,941]}} alt="Directed perfume campaign concept"/></div><div class="process-line"><div><strong>Process.</strong></div><div><span>01</span>Brief</div><div><span>02</span>Art direction</div><div><span>03</span>Human refinement</div></div></section>
  </main><Footer />
</BaseLayout>
