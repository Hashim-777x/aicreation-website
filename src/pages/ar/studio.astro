---
import BaseLayout from '@/layouts/BaseLayout.astro'; import PageHero from '@/components/PageHero.astro'; import Footer from '@/components/Footer.astro'; import ResponsiveImage from '@/components/ResponsiveImage.astro';
const methods=[['01','الموجز','نتفق على الهدف والجمهور والحدود لصياغة موجز إبداعي واضح.'],['02','الرؤية','نستكشف الأفكار ونحدّد الرؤية البصرية والتقنية.'],['03','الإنتاج','نبدع ونطوّر ونبني بقرارات بشرية مدروسة.'],['04','الصقل','نصقل التفاصيل للوصول إلى مستوى العمل المطلوب.']];
---
<BaseLayout title="الاستوديو — AIcreation.pro" description="A small studio combining creative direction and engineering.">
  <main id="main-content"><PageHero class="studio-page-hero" headerTheme="light" brandTheme="dark" eyebrow="استوديونا" title="استوديو صغير.<br />تعاون مباشر." intro="الإنتاج الإبداعي والهندسة، في فريق واحد." desktop="studio-page-hero-desktop" mobile="studio-page-hero-mobile" />
  <section class="editorial-section studio-intro section-space--feature"><h2 data-reveal>تخصّصان. ورؤية واحدة.</h2><p class="lead">الذوق البشري يصوغ العمل. والتقنية توسّع إمكاناتنا.</p><div class="people-grid"><article class="person"><h3>هاشم</h3><p class="concept-label">الهندسة والأنظمة</p><p>يبني الأنظمة والأدوات ومسارات العمل التي تحوّل الأفكار إلى واقع.</p></article><article class="person"><h3>ألطاف</h3><p class="concept-label">الإبداع والإنتاج</p><p>يقود الإبداع من الفكرة إلى اللقطة الأخيرة بعناية بالحرفة والتفاصيل.</p></article></div></section>
  <section class="editorial-section dark-process section-space--standard"><p class="concept-label">طريقتنا</p><h2 data-reveal>كيف نعمل.</h2><div class="method-list">{methods.map(([number,title,copy])=><article class="method-row"><b>{number}</b><h3>{title}</h3><p>{copy}</p></article>)}</div></section>
  <section class="editorial-section section-space--feature"><p class="concept-label">ما نؤمن به</p><h2 data-reveal>التفاصيل جوهر العمل.</h2><div class="detail-grid"><article><ResponsiveImage desktop="studio-detail-texture" mobile="studio-detail-texture" widths={{desktop:[750],mobile:[750]}} alt="Burgundy textile texture detail"/><h3>الخامة</h3><p>الخامة والضوء والأجواء تمنح المشهد مصداقيته.</p></article><article><ResponsiveImage desktop="studio-detail-product-fidelity" mobile="studio-detail-product-fidelity" widths={{desktop:[700],mobile:[700]}} alt="Amber bottle product fidelity detail"/><h3>دقّة المنتج</h3><p>التفاصيل الواقعية تبني الثقة وتترك أثرًا.</p></article><article><ResponsiveImage desktop="studio-detail-consistency" mobile="studio-detail-consistency" widths={{desktop:[880],mobile:[880]}} alt="Printed campaign consistency detail"/><h3>الاتساق</h3><p>عالم بصري متّسق يصنع عملًا أقوى.</p></article></div></section>
  </main><Footer />
</BaseLayout>
