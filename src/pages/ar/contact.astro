---
import EmailDraftOptions from '@/components/EmailDraftOptions.astro';
import BaseLayout from '@/layouts/BaseLayout.astro'; import Header from '@/components/Header.astro'; import Footer from '@/components/Footer.astro'; import ResponsiveImage from '@/components/ResponsiveImage.astro'; import ActionLink from '@/components/ActionLink.astro';
---
<BaseLayout title="تواصل معنا — AIcreation.pro" description="Tell AIcreation.pro about your campaign, film or workflow.">
  <Header theme="dark" brandTheme="dark" />
  <main id="main-content"><section class="contact-main section-space--hero"><div class="contact-copy" data-reveal><h1>أحضر الفكرة.<br />لنصوغ<br />الرؤية.</h1><p class="page-intro">حملة أو فيلم أو سير عمل يستحق التنفيذ.</p><h2>hello@aicreation.pro</h2><p>تواصل مباشرة مع فريق الاستوديو.</p><ResponsiveImage desktop="contact-page-portrait-desktop" mobile="contact-page-portrait-mobile" widths={{desktop:[1000,1448],mobile:[640,941]}} alt="بورتريه أزياء تصوّري بدرجات خمرية" class="contact-portrait" /></div>
  <form id="brief" class="brief-form" data-brief-form novalidate><label>الاسم<input name="name" autocomplete="name" placeholder="اسمك" required /></label><label>البريد المهني<input name="email" type="email" autocomplete="email" placeholder="you@company.com" required /></label><label>العلامة التجارية / الموقع الإلكتروني<input name="brand" placeholder="اسم علامتك التجارية أو رابط موقعك" /></label><fieldset><legend>الخدمة التي تهمك</legend><div><label><input type="radio" name="interest" value="creative" required /> الإبداع بالذكاء الاصطناعي</label><label><input type="radio" name="interest" value="agents" /> وكلاء الذكاء الاصطناعي</label><label><input type="radio" name="interest" value="both" /> كلاهما</label></div></fieldset><label>الإطار الزمني<select name="timeline" required><option value="">اختر المدة</option><option>خلال شهر</option><option>من شهر إلى ثلاثة أشهر</option><option>أستكشف الخيارات</option></select></label><label>نطاق الميزانية<select name="budget" required><option value="">اختر النطاق</option><option>$1,000–$2,500</option><option>$2,500–$5,000</option><option>$5,000+</option></select></label><label>موجز المشروع<textarea name="brief" rows="6" placeholder="حدّثنا عن فكرتك أو مشروعك أو أهدافك..." required></textarea></label><label>رابط مرجعي (اختياري)<input name="reference" type="url" placeholder="https://" /></label><ActionLink label="أرسل موجزك" variant="primary" type="submit" /><p class="form-status" role="status" aria-live="polite"></p><EmailDraftOptions /></form></section>
  <section class="editorial-section section-space--compact"><div class="next-grid"><h2>الخطوة<br />التالية.</h2><article><span>01</span><h3>مراجعة الموجز</h3><p>نقرأ التفاصيل ونتعرّف على مشروعك.</p></article><article><span>02</span><h3>مناقشة النطاق</h3><p>نستكشف الفرصة معًا.</p></article><article><span>03</span><h3>الاتفاق على الخطوة التالية</h3><p>نتفق على أنسب طريقة للبدء.</p></article></div></section></main><Footer />

</BaseLayout>
