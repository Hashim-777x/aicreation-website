---
import LoopMedia from '@/components/LoopMedia.astro';
import BaseLayout from '@/layouts/BaseLayout.astro'; import PageHero from '@/components/PageHero.astro'; import Footer from '@/components/Footer.astro'; import ResponsiveImage from '@/components/ResponsiveImage.astro';
---
<BaseLayout title="الإبداع بالذكاء الاصطناعي — AIcreation.pro" description="Human-directed AI campaign images and films.">
  <main id="main-content"><PageHero headerTheme="light" brandTheme="dark" eyebrow="الإبداع بالذكاء الاصطناعي" title="ذكاء<br />اصطناعي.<br />ذوق بشري." intro="صور وأفلام للحملات، تنطلق من هوية علامتك." desktop="perfume-finished-desktop" mobile="perfume-finished-mobile" widths={{desktop:[640,1000],mobile:[640,941]}} cta={{label:'ناقش حملتك',href:'/ar/contact',variant:'primary'}} />
  <section class="editorial-section section-space--feature"><h2 data-reveal>ما نقدّمه.</h2><div class="creative-services">
    <article class="creative-service" data-reveal><ResponsiveImage desktop="ai-creative-product-macro-desktop" mobile="ai-creative-product-macro-mobile" widths={{desktop:[1280,1920],mobile:[640,941]}} alt="دراسة تصورية لتفاصيل منتج عن قرب"/><h3>صور المنتجات</h3><p>صور منتجات تبرز التفاصيل والخامات والإحساس.</p></article>
    <article class="creative-service" data-reveal><ResponsiveImage desktop="ai-creative-burgundy-fashion-desktop" mobile="ai-creative-burgundy-fashion-mobile" widths={{desktop:[1280,1920],mobile:[640,941]}} alt="عارضة بقماش خمري لقصة أزياء تحريرية"/><h3>قصص الأزياء</h3><p>حملات بطابع تحريري ورؤية واضحة.</p></article>
    <article class="creative-service" data-reveal><ResponsiveImage desktop="residence-desktop" mobile="residence-mobile" widths={{desktop:[960,1600],mobile:[640,941]}} alt="دراسة تصورية لمسكن"/><h3>المساحات والعقارات</h3><p>صور تنقل أجواء الضيافة والعقارات والتصميم الداخلي.</p></article>
    <article class="creative-service short-film-card" data-reveal><LoopMedia videoKey="short-films" class="short-film-poster" desktop="ai-creative-short-film-desktop" mobile="ai-creative-short-film-mobile" widths={{desktop:[1280,1920],mobile:[640,941]}} alt="ملصق سينمائي بقماش خمري تحرّكه الريح حول الشخصية"/><h3>أفلام قصيرة</h3><p>أفلام سينمائية للعلامات ومحتوى اجتماعي يترك أثرًا.</p></article>
  </div></section>
  <section class="editorial-section section-space--standard" data-reveal><h2>الرؤية الإبداعية<br />تصنع الفارق.</h2><div class="comparison-wide"><ResponsiveImage desktop="perfume-source-desktop" mobile="perfume-source-mobile" widths={{desktop:[640,1000],mobile:[640,941]}} alt="صورة العطر قبل التوجيه الإبداعي"/><ResponsiveImage desktop="perfume-finished-desktop" mobile="perfume-finished-mobile" widths={{desktop:[640,1000],mobile:[640,941]}} alt="صورة العطر بعد التوجيه الإبداعي"/></div></section>
  <section class="editorial-section dark-process section-space--compact"><h2 data-reveal>توجيه بشري،<br />في كل مرحلة.</h2><div class="steps-grid"><article><b>01</b><h3>موجز المشروع</h3><p>نحدّد الأهداف والجمهور والأسلوب البصري.</p></article><article><b>02</b><h3>التوجيه الإبداعي</h3><p>نطوّر الأفكار والتكوين والأجواء.</p></article><article><b>03</b><h3>الإنتاج</h3><p>ننتج ونراجع مع التحقق من تفاصيل المنتج.</p></article><article><b>04</b><h3>الصقل</h3><p>نراجع التفاصيل والتحرير ونضيف اللمسات النهائية.</p></article></div></section>
  </main><Footer />
</BaseLayout>

