---
import BaseLayout from '@/layouts/BaseLayout.astro'; import PageHero from '@/components/PageHero.astro'; import Footer from '@/components/Footer.astro'; import ResponsiveImage from '@/components/ResponsiveImage.astro';
const methods=[['01','Brief','We align on the goal, audience and constraints to define a clear creative brief.'],['02','Direction','We explore ideas and set the visual and technical direction.'],['03','Production','We create, iterate and engineer with human judgement.'],['04','Refinement','We fine-tune every detail until the work meets the highest standard.']];
---
<BaseLayout title="Studio — AIcreation.pro" description="A small studio combining creative direction and engineering.">
  <main><PageHero headerTheme="light" brandTheme="dark" eyebrow="Our studio" title="Small studio.<br />Direct collaboration." intro="Creative production and engineering, working together." desktop="studio-page-hero-desktop" mobile="studio-page-hero-mobile" />
  <section class="editorial-section studio-intro section-space--feature"><h2 data-reveal>Two disciplines. One direction.</h2><p class="lead">Human taste shapes the work. Technology expands what we can make.</p><div class="people-grid"><article class="person"><h3>Hashim</h3><p class="concept-label">Engineering &amp; systems</p><p>Builds the systems, tools and workflows that make new ideas possible.</p></article><article class="person"><h3>Altaf</h3><p class="concept-label">Creative &amp; production</p><p>Directs the creative from concept to final frame with a sharp eye for craft.</p></article></div></section>
  <section class="editorial-section dark-process section-space--standard"><p class="concept-label">Our process</p><h2 data-reveal>How we work.</h2><div class="method-list">{methods.map(([number,title,copy])=><article class="method-row"><b>{number}</b><h3>{title}</h3><p>{copy}</p></article>)}</div></section>
  <section class="editorial-section section-space--feature"><p class="concept-label">Our manifesto</p><h2 data-reveal>The details are the work.</h2><div class="detail-grid"><article><ResponsiveImage desktop="studio-detail-texture" mobile="studio-detail-texture" widths={{desktop:[750],mobile:[750]}} alt="Burgundy textile texture detail"/><h3>Texture</h3><p>Material, light and atmosphere create believability.</p></article><article><ResponsiveImage desktop="studio-detail-product-fidelity" mobile="studio-detail-product-fidelity" widths={{desktop:[700],mobile:[700]}} alt="Amber bottle product fidelity detail"/><h3>Product fidelity</h3><p>Real-world detail builds trust and lasting impact.</p></article><article><ResponsiveImage desktop="studio-detail-consistency" mobile="studio-detail-consistency" widths={{desktop:[880],mobile:[880]}} alt="Printed campaign consistency detail"/><h3>Consistency</h3><p>A coherent visual world makes stronger work.</p></article></div></section>
  </main><Footer />
</BaseLayout>
