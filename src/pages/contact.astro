---
import BaseLayout from '@/layouts/BaseLayout.astro'; import Header from '@/components/Header.astro'; import Footer from '@/components/Footer.astro'; import ResponsiveImage from '@/components/ResponsiveImage.astro'; import ActionLink from '@/components/ActionLink.astro';
---
<BaseLayout title="Contact — AIcreation.pro" description="Tell AIcreation.pro about your campaign, film or workflow.">
  <Header theme="dark" brandTheme="dark" />
  <main><section class="contact-main section-space--hero"><div class="contact-copy" data-reveal><h1>Tell us what<br />you have<br />in mind.</h1><p class="page-intro">A campaign, a film, or a workflow worth building.</p><h2>hello@aicreation.pro</h2><p>Work directly with the studio.</p><ResponsiveImage desktop="contact-page-portrait-desktop" mobile="contact-page-portrait-mobile" widths={{desktop:[1000,1448],mobile:[640,941]}} alt="Burgundy fashion portrait concept" class="contact-portrait" /></div>
  <form class="brief-form" data-brief-form novalidate><label>Name<input name="name" autocomplete="name" placeholder="Your name" required /></label><label>Work email<input name="email" type="email" autocomplete="email" placeholder="you@company.com" required /></label><label>Brand / website<input name="brand" placeholder="Your brand or website" /></label><fieldset><legend>Interested in</legend><div><label><input type="radio" name="interest" value="creative" required /> AI creative</label><label><input type="radio" name="interest" value="agents" /> AI agents</label><label><input type="radio" name="interest" value="both" /> Both</label></div></fieldset><label>Timeline<select name="timeline" required><option value="">Select a timeline</option><option>Within one month</option><option>1–3 months</option><option>Exploring</option></select></label><label>Budget range<select name="budget" required><option value="">Select a range</option><option>$1,000–$2,500</option><option>$2,500–$5,000</option><option>$5,000+</option></select></label><label>Project brief<textarea name="brief" rows="6" placeholder="Tell us about your idea, project or goals..." required></textarea></label><label>Reference link (optional)<input name="reference" type="url" placeholder="https://" /></label><ActionLink label="Send your brief" variant="primary" type="submit" /><p class="form-status" role="status" aria-live="polite"></p></form></section>
  <section class="editorial-section section-space--compact"><div class="next-grid"><h2>What<br />happens next.</h2><article><span>01</span><h3>Review the brief</h3><p>We read and get to know your project.</p></article><article><span>02</span><h3>Discuss the scope</h3><p>We explore the opportunity together.</p></article><article><span>03</span><h3>Agree the next step</h3><p>We align on the best way forward.</p></article></div></section></main><Footer />
  <script>
    const form=document.querySelector<HTMLFormElement>('[data-brief-form]'); form?.addEventListener('submit',(event)=>{event.preventDefault();const status=form.querySelector<HTMLElement>('.form-status');const button=form.querySelector<HTMLButtonElement>('button[type="submit"]');const label=button?.querySelector<HTMLElement>('.cta__label');if(!form.checkValidity()){form.dataset.state='error';form.reportValidity();if(status)status.textContent='Please complete the required fields.';return;}form.dataset.state='loading';if(button){button.disabled=true;button.setAttribute('aria-busy','true');}if(label)label.textContent='Sending…';if(status)status.textContent='Preparing your brief…';window.setTimeout(()=>{form.dataset.state='success';if(button){button.disabled=false;button.removeAttribute('aria-busy');}if(label)label.textContent='Send your brief';if(status)status.textContent='Your brief is ready. Until delivery is connected, email hello@aicreation.pro.';},450);});
  </script>
</BaseLayout>
